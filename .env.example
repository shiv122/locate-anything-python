# Public port the FastAPI API listens on.
PORT=8080

# Model + generation defaults (defaults match the baked-in image).
LOCATE_MODEL=nvidia/LocateAnything-3B
LOCATE_DEVICE=cuda
GENERATION_MODE=hybrid
# Default detection targets when a request omits `query`.
# LOCATE_DEFAULT_QUERY=brands, logos, texts
# MAX_NEW_TOKENS=2048
# ATTN_IMPLEMENTATION=sdpa
# Downscale the longest image side before inference (0 = off). Lower (e.g. 768)
# if you hit CUDA OOM on a small GPU; raise for sharper small-logo/text detection.
# LOCATE_MAX_SIDE=1024

# Limits for the inbound image fetch.
# DOWNLOAD_TIMEOUT_SECONDS=30
# MAX_IMAGE_BYTES=26214400

# The default model (nvidia/LocateAnything-3B) is public — no token needed.
# For a gated model, pass the token as a BuildKit secret (see Dockerfile),
# not as an ARG/ENV.
